# Fins de ligne normalisées : LF dans le dépôt et à l'extraction,
# pour que les scripts shell et fichiers de configuration restent valides sur la Pi.
* text=auto eol=lf

# Scripts Windows
*.ps1 text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.glb binary
