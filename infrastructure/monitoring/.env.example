# KAIVIRO — variables de la pile de supervision.
# Copier en .env sur la Pi (jamais commité). Aucune valeur réelle ici.

# IP VPN de la Pi : tous les ports publiés y sont liés (voir NETWORK_AND_VPN §2).
BIND_ADDR=

# Rétention des séries Prometheus (ex. 15d).
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_ROOT_URL=
GRAFANA_ADMIN_USER=
# Chemin d'un fichier local root:root 0400 contenant le mot de passe. Le mot de passe n'est jamais écrit ici.
GRAFANA_ADMIN_PASSWORD_FILE=

# ntfy
NTFY_BASE_URL=
