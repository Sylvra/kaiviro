# KAIVIRO — variables des sauvegardes.
# Copier en .env sur la Pi (root:root 0600, jamais commité). Aucune valeur réelle ici.

# Dépôts restic (chemin local ou URL de backend SANS identifiants intégrés).
RESTIC_REPOSITORY_LOCAL=
RESTIC_REPOSITORY_OFFSITE=

# Chemin d'un fichier root:root 0400 contenant le mot de passe du dépôt (copie dans le coffre, ADR-0011).
RESTIC_PASSWORD_FILE=

# Rétention
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Fichiers témoins pour restore-test.sh (chemins absolus séparés par des espaces).
RESTORE_WITNESS_FILES=

# Dossier d'état lu par le Command Center (source S6).
KAIVIRO_STATE_DIR=/var/lib/kaiviro/backup-state
