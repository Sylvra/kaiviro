# Copier en .env.local (jamais commité) et remplir soi-même.
# Aucune valeur réelle dans ce fichier.

# S1/S2 — GitHub. Jeton fine-grained limité au dépôt : Contents read, Issues read and write,
# Pull requests read. Sans Issues write, le tableau reste lisible mais les statuts ne s'enregistrent pas.
GITHUB_REPO=Sylvra/kaiviro
GITHUB_TOKEN=

# Plan M0 — date du J1 (AAAA-MM-JJ). Vide : date de création du dépôt GitHub.
PLAN_START=

# S3 — Google Drive (dossier VAULT, lecture seule) — CC-M1+ après validation
DRIVE_VAULT_FOLDER_ID=

# S4–S6 — Raspberry Pi via VPN — CC-M2
UPTIME_KUMA_URL=
PROMETHEUS_URL=
BACKUP_STATUS_URL=

# S7 — contrat de supervision du backend (Mission B) — CC-M2
APP_HEALTH_URL=

# S8 — Supabase, schéma admin — CC-M1 (CRM) / CC-M3 (audit)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
