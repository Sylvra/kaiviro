# Copier en .env.local (jamais commité) et remplir soi-même.
# Aucune valeur réelle dans ce fichier.

# S1/S2 — GitHub. Jeton fine-grained limité au dépôt : Contents read, Issues read and write,
# Pull requests read, Actions read (carte CI). Sans Issues write, le tableau reste lisible mais les statuts ne s'enregistrent pas.
GITHUB_REPO=Sylvra/kaiviro
GITHUB_TOKEN=

# Plan M0 — date du J1 (AAAA-MM-JJ). Vide : date de création du dépôt GitHub.
PLAN_START=

# CRM Partenaires (fichier local, jamais dans Git). Vides : data/partners.json et data/backups.
# PARTNERS_BACKUP_DIR peut viser un autre disque pour survivre à une panne du disque principal.
PARTNERS_FILE=
PARTNERS_BACKUP_DIR=

# S3 — Google Drive (dossier VAULT, lecture seule) — CC-M1+ après validation
DRIVE_VAULT_FOLDER_ID=

# S4–S6 — Raspberry Pi via VPN (adresses de la pile infrastructure/monitoring). Vides : panneau « non supervisée ».
# Ex. PROMETHEUS_URL=http://<ip-vpn-pi>:9090 · UPTIME_KUMA_URL=http://<ip-vpn-pi>:3001
UPTIME_KUMA_URL=
# Identifiant (slug) d'une page de statut publique créée dans Uptime Kuma
UPTIME_KUMA_STATUS_PAGE=
PROMETHEUS_URL=
# URL qui sert latest-backup.json (schéma backup-run)
BACKUP_STATUS_URL=
# Services systemd suivis (regex, sans « .service »). Vide : valheim.*|prometheus.*|uptime-kuma|tailscaled|ssh
# Node Exporter doit tourner avec --collector.systemd.
PI_SYSTEMD_UNITS=

# S7 — contrat de supervision du backend (Mission B). Base URL : le Command Center lit <URL>/health/details.
APP_HEALTH_URL=

# S8 — Supabase, schéma admin — CC-M1 (CRM) / CC-M3 (audit)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
